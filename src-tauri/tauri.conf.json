{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanes",
  "version": "0.1.1",
  "identifier": "com.synthetixis.lanes",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Lanes",
        "width": 300,
        "height": 420,
        "minWidth": 300,
        "maxWidth": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.productivity",
    "shortDescription": "Open AI desktop apps in isolated profiles.",
    "longDescription": "Lanes is a tiny menu-bar launcher that opens AI desktop apps, each in its own isolated profile, so work and personal accounts run side by side. It never touches auth tokens and makes no network requests.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
